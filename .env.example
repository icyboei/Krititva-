# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# Optional: GitHub Personal Access Token (increases API rate limits from 60/hr to 5,000/hr)
# GITHUB_TOKEN=ghp_your_github_token_here

# Optional: AI Provider (e.g. Gemma via Google AI Studio / Gemini API)
# GEMMA_API_KEY=your_api_key_here
# GEMMA_MODEL=gemma-2-9b-it
